{
  "permissions": {
    "allow": [
      "Bash(rm -rf /tmp/repro-out2)",
      "Bash(npx tsc *)",
      "Bash(node repro-out/repro.js)",
      "Bash(node -e \"console.log\\('eval:', typeof crypto\\)\")",
      "Bash(echo \"console.log\\('file:', typeof crypto\\);\")",
      "Bash(node plain.js)",
      "Bash(cd /tmp)",
      "Bash(echo \"console.log\\('file-outside-project:', typeof crypto\\);\")",
      "Bash(node /tmp/plain2.js)",
      "Bash(node -p \"process.execPath\")",
      "Bash(env)",
      "Bash(node -p \"process.allowedNodeEnvironmentFlags.has\\('--experimental-global-webcrypto'\\)\")",
      "Bash(node --v8-options)",
      "Bash(node -e \"console.log\\(Object.getOwnPropertyDescriptor\\(globalThis, 'crypto'\\)\\)\")",
      "Bash(nvm list *)",
      "Bash(nvm install *)",
      "Bash(nvm use *)",
      "Bash(node -e \"console.log\\(typeof crypto\\)\")",
      "Bash(rm -rf node_modules package-lock.json)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(nslookup -type=SRV _mongodb._tcp.onde-assistir.dmxjxxu.mongodb.net)",
      "Bash(node -e \"require\\('dns'\\).promises.resolveSrv\\('_mongodb._tcp.onde-assistir.dmxjxxu.mongodb.net'\\).then\\(r=>console.log\\('OK',r\\)\\).catch\\(e=>console.log\\('FAIL',e.code\\)\\)\")",
      "Bash(netsh interface *)",
      "Bash(curl -s 'https://onde-assistir-k8rm.vercel.app/api/copa-2026/jogos' -H 'Accept: application/json')",
      "Bash(curl -s -w \"\\\\nHTTP_STATUS:%{http_code}\\\\n\" 'https://onde-assistir-k8rm.vercel.app/api/copa-2026/jogos' -H 'Accept: application/json' -o /tmp/copa_response.json)",
      "Read(//tmp/**)",
      "Bash(curl -sv 'https://onde-assistir-k8rm.vercel.app/api/copa-2026/jogos')",
      "Bash(curl -sk 'https://onde-assistir-k8rm.vercel.app/api/copa-2026/jogos')",
      "Bash(python3 -c ' *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(git log *)",
      "Bash(npx ng *)",
      "Bash(git fetch *)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(cat | jq -r '.tool_input.command // empty' 2>/dev/null || echo ''); block=false; if echo \"$cmd\" | grep -qE '^git push' && echo \"$cmd\" | grep -q 'main'; then block=true; fi; if echo \"$cmd\" | grep -qE '^git (commit|merge|reset|rebase)'; then branch=$(git branch --show-current 2>/dev/null); [ \"$branch\" = \"main\" ] && block=true; fi; if [ \"$block\" = \"true\" ]; then echo '{\"decision\":\"block\",\"reason\":\"A branch main é protegida e não aceita push direto. Nunca faça commit, push, merge ou reset diretamente na main — crie ou mude para uma branch de feature.\"}'; fi"
          }
        ]
      }
    ]
  }
}
