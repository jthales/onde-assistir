PORT=3000

# Jogos (MongoDB) - obrigatório para GET /api/jogos
MONGODB_URI=mongodb+srv://usuario:senha@cluster/...

# Populate com transmissões via Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Push notifications (Firebase Admin) - opcional para rodar a API
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rotas /api/admin/*
ADMIN_SECRET=
